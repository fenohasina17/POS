APP_NAME="POS Central"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:9000
APP_VERSION=1.0.0

FRONTEND_URL=http://localhost:9001
SANCTUM_STATEFUL_DOMAINS=localhost:9001
SANCTUM_TOKEN_EXPIRATION=480

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base de données centrale (différente des POS locaux)
DB_CONNECTION=pgsql
DB_HOST=central_db
DB_PORT=5432
DB_DATABASE=pos_central
DB_USERNAME=central
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=central_redis
REDIS_PORT=6379
REDIS_PASSWORD=

QUEUE_CONNECTION=database

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Connexion interne (backend/worker → reverb) — jamais via nginx/TLS.
# En production, garder central_reverb/8080/http : le backend PHP publie
# les events directement au conteneur reverb, pas via le domaine public.
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Connexion navigateur (dashboard → reverb via le proxy nginx /app/).
# En production : le domaine public, port 443, scheme https.
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=ws

# Clé API que les terminaux POS doivent présenter pour envoyer leurs données
# Doit correspondre à CENTRAL_API_KEY dans le .env de chaque caisse
CENTRAL_API_KEY=

# Compte administrateur créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@central.local
ADMIN_PASSWORD=changeme
