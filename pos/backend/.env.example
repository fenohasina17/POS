APP_NAME=POS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Token secret pour l'endpoint /api/health (monitoring Uptime Kuma)
# Configurer le même token dans Uptime Kuma > Monitor > Custom Header: X-Health-Token
HEALTH_CHECK_TOKEN=

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_TOKEN_EXPIRATION=480

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pos_system
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 'database' = jobs persistés en base, traités par le service worker du compose
QUEUE_CONNECTION=database

# ── Synchronisation vers le serveur central ───────────────────────────────────
# Laisser vide pour faire fonctionner le POS en mode standalone (sans central)
CENTRAL_SERVER_URL=
CENTRAL_API_KEY=

# Identité de ce terminal POS — unique par caisse
TERMINAL_ID=pos-1
RESTAURANT_ID=restaurant-1

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8000
REVERB_SCHEME=ws
