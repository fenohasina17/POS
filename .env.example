# Application
APP_NAME=POS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# Frontend
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Expiration des tokens API en minutes (480 = 8h, 0 = jamais — déconseillé)
SANCTUM_TOKEN_EXPIRATION=480

# URL de l'API injectée à runtime dans le container frontend (pas au build)
VITE_API_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pos_system
DB_USERNAME=
DB_PASSWORD=

# Cache
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue — 'database' = jobs persistés en base, traités par le service worker
QUEUE_CONNECTION=database

# Logging — 'daily' = 1 fichier par jour, conserve 14 jours
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Broadcasting (Reverb WebSocket)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8000
REVERB_SCHEME=ws
